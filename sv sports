            <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-sage-600/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="max-w-3xl mb-6">
                <div class="inline-flex items-center space-x-2 bg-sage-800/80 border border-sage-700/60 px-3.5 py-1.5 rounded-full text-sage-300 text-xs font-semibold uppercase tracking-wider mb-3">
                    <i class="fa-solid fa-wand-magic-sparkles text-sage-400"></i>
                    <span>SV Smart Advisor</span>
                </div>
