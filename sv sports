<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SV SPORTS | Premium Athletic Gear & Apparel</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sage: {
                            50: '#F3F5F3',
                            100: '#E4E8E4',
                            200: '#C7D1C7',
                            300: '#A6B6A7',
                            400: '#899B8A',
                            500: '#6C7E6D',
                            600: '#566657',
                            700: '#435044',
                            800: '#323C33',
                            900: '#232924',
                        },
                        cream: '#FAF9F6',
                        sand: '#E6E4DE',
                        charcoal: '#1E211F',
                        muted: '#7C7D79',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #FAF9F6;
            color: #1E211F;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FAF9F6;
        }
        ::-webkit-scrollbar-thumb {
            background: #A6B6A7;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #6C7E6D;
        }
        .carousel-slide {
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-nav {
            background: rgba(250, 249, 246, 0.88);
            backdrop-filter: blur(16px);
        }
        .glow-subtle {
            box-shadow: 0 10px 30px -10px rgba(108, 126, 109, 0.15);
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col justify-between selection:bg-sage-600 selection:text-white">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-charcoal text-cream text-[11px] tracking-widest py-2.5 text-center uppercase font-medium border-b border-sage-800">
        <i class="fa-solid fa-truck-fast text-sage-400 mr-1.5"></i> Complimentary Shipping on Orders Over $100 &nbsp;|&nbsp; Crafted for Athletic Excellence
    </div>

    <!-- NAVIGATION HEADER -->
    <header class="sticky top-0 z-40 glass-nav border-b border-sand/80 transition-all duration-300" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">

                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <a href="#" class="flex items-center space-x-2.5 group">
                        <span class="w-10 h-10 rounded-2xl bg-sage-600 text-cream flex items-center justify-center font-bold text-lg tracking-wider group-hover:bg-charcoal transition-all shadow-sm">SV</span>
                        <div class="flex flex-col">
                            <span class="text-xl font-bold tracking-tight text-charcoal leading-none">SV <span class="text-sage-600 font-light">SPORTS</span></span>
                            <span class="text-[9px] uppercase tracking-widest text-muted font-semibold mt-0.5">Est. 2021</span>
                        </div>
                    </a>
                </div>

                <!-- Desktop Nav Links -->
                <nav class="hidden md:flex space-x-9 text-sm font-medium text-charcoal">
                    <a href="#hero" class="hover:text-sage-600 transition-colors py-2">Home</a>
                    <a href="#categories" class="hover:text-sage-600 transition-colors py-2">Disciplines</a>
                    <a href="#shop" class="hover:text-sage-600 transition-colors py-2">Catalog</a>
                    <a href="#ai-assistant" class="hover:text-sage-600 transition-colors py-2 flex items-center space-x-1.5 text-sage-700 font-semibold bg-sage-50 px-3 py-1 rounded-full border border-sage-200">
                        <i class="fa-solid fa-wand-magic-sparkles text-sage-600 text-xs"></i>
                        <span>Smart Advisor</span>
                    </a>
                    <a href="#about" class="hover:text-sage-600 transition-colors py-2">About</a>
