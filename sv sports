                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-2.5 text-xs text-muted"></i>
                    </div>

                    <!-- AI Smart Assistant Trigger -->
                    <a href="#ai-assistant" class="p-2 text-charcoal hover:text-sage-600 transition-colors rounded-full hover:bg-sand/40" title="AI Shopping Assistant">
