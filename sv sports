            </div>

            <!-- Empty Search State -->
            <div id="emptyCatalogState" class="hidden text-center py-20">
                <div class="w-16 h-16 bg-sage-50 text-sage-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
