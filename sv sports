                        <span id="cartBadge" class="absolute top-0 right-0 bg-sage-600 text-cream text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-cream hidden">0</span>
                    </button>

                    <!-- Mobile Menu Button -->
                    <button id="mobileMenuBtn" class="md:hidden p-2 text-charcoal focus:outline-none rounded-lg hover:bg-sand/40" aria-label="Toggle Menu">
                        <i class="fa-solid fa-bars text-xl" id="menuIcon"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu Dropdown -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-sand bg-cream px-5 pt-4 pb-6 space-y-3">
            <div class="mb-3">
                <input type="text" id="mobileSearchInput" placeholder="Search products..."
                    class="w-full pl-9 pr-4 py-2.5 text-xs rounded-full bg-sand/60 border border-sand focus:border-sage-500 focus:outline-none">
            </div>
            <a href="#hero" class="block py-2 text-base font-medium text-charcoal hover:text-sage-600">Home</a>
            <a href="#categories" class="block py-2 text-base font-medium text-charcoal hover:text-sage-600">Disciplines</a>
            <a href="#shop" class="block py-2 text-base font-medium text-charcoal hover:text-sage-600">Shop Catalog</a>
            <a href="#ai-assistant" class="block py-2 text-base font-semibold text-sage-700">Smart Advisor (AI)</a>
            <a href="#about" class="block py-2 text-base font-medium text-charcoal hover:text-sage-600">About Us</a>
        </div>
    </header>

    <!-- HERO SECTION WITH CAROUSEL -->
    <section id="hero" class="relative bg-sand/20 overflow-hidden border-b border-sand/60">
        <div class="relative min-h-[540px] lg:min-h-[640px] flex items-center">
            
            <!-- Carousel Slides -->
            <div id="carouselContainer" class="absolute inset-0">
                <!-- Slide 1 -->
                <div class="carousel-slide absolute inset-0 opacity-100 transition-opacity duration-1000 flex items-center">
                    <img src="https://images.unsplash.com/photo-1517649763962-0c623266010b?q=80&w=1600&auto=format&fit=crop" 
                         alt="Athletic Endurance" class="absolute inset-0 w-full h-full object-cover opacity-20 object-center">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
                        <div class="max-w-xl">
                            <span class="inline-flex items-center space-x-2 px-3.5 py-1 bg-sage-600 text-cream text-[11px] font-semibold tracking-wider uppercase rounded-full mb-4 shadow-sm">
                                <i class="fa-solid fa-sparkles text-[10px]"></i>
                                <span>2026 Collection</span>
                            </span>
                            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-charcoal mb-4 leading-[1.15]">Elevate Athletic Mastery</h1>
                            <p class="text-base sm:text-lg text-muted mb-8 leading-relaxed font-normal">Precision-engineered sports equipment designed for athletes who value quiet elegance and uncompromised durability.</p>
                            <div class="flex flex-wrap gap-4">
                                <a href="#shop" class="px-7 py-3.5 bg-sage-600 text-cream font-semibold text-sm rounded-full hover:bg-charcoal transition-all shadow-md hover:shadow-lg">Explore Collection</a>
                                <a href="#ai-assistant" class="px-7 py-3.5 bg-white border border-sand text-charcoal font-semibold text-sm rounded-full hover:border-sage-500 transition-all shadow-sm flex items-center space-x-2">
                                    <i class="fa-solid fa-wand-magic-sparkles text-sage-600"></i>
                                    <span>Consult AI Advisor</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-1000 flex items-center">
                    <img src="https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?q=80&w=1600&auto=format&fit=crop" 
                         alt="Cricket Mastercraft" class="absolute inset-0 w-full h-full object-cover opacity-20 object-center">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
                        <div class="max-w-xl">
                            <span class="inline-flex items-center space-x-2 px-3.5 py-1 bg-charcoal text-cream text-[11px] font-semibold tracking-wider uppercase rounded-full mb-4 shadow-sm">
                                <span>Mastercraft Series</span>
                            </span>
                            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-charcoal mb-4 leading-[1.15]">Crafted for the Boundary</h1>
                            <p class="text-base sm:text-lg text-muted mb-8 leading-relaxed font-normal">Grade 1 English Willow bats and impact-reducing protective gear built for peak tournament performance.</p>
                            <div class="flex flex-wrap gap-4">
                                <button onclick="filterByCategory('Cricket')" class="px-7 py-3.5 bg-sage-600 text-cream font-semibold text-sm rounded-full hover:bg-charcoal transition-all shadow-md">Shop Cricket Gear</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-1000 flex items-center">
                    <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=1600&auto=format&fit=crop" 
                         alt="Minimalist Gym" class="absolute inset-0 w-full h-full object-cover opacity-20 object-center">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
                        <div class="max-w-xl">
                            <span class="inline-flex items-center space-x-2 px-3.5 py-1 bg-sage-700 text-cream text-[11px] font-semibold tracking-wider uppercase rounded-full mb-4 shadow-sm">
                                <span>Home Gym Architecture</span>
                            </span>
                            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-charcoal mb-4 leading-[1.15]">Refined Strength Equipment</h1>
                            <p class="text-base sm:text-lg text-muted mb-8 leading-relaxed font-normal">Ergonomic design meets natural materials for high-intensity indoor conditioning.</p>
                            <div class="flex flex-wrap gap-4">
                                <button onclick="filterByCategory('Fitness')" class="px-7 py-3.5 bg-sage-600 text-cream font-semibold text-sm rounded-full hover:bg-charcoal transition-all shadow-md">Shop Fitness Equipment</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Carousel Indicators -->
            <div class="absolute bottom-6 left-0 right-0 z-20 flex justify-center space-x-3">
                <button onclick="setSlide(0)" class="carousel-dot w-8 h-1.5 rounded-full bg-sage-600 transition-all" aria-label="Slide 1"></button>
                <button onclick="setSlide(1)" class="carousel-dot w-2.5 h-1.5 rounded-full bg-muted/40 hover:bg-sage-500 transition-all" aria-label="Slide 2"></button>
                <button onclick="setSlide(2)" class="carousel-dot w-2.5 h-1.5 rounded-full bg-muted/40 hover:bg-sage-500 transition-all" aria-label="Slide 3"></button>
            </div>
        </div>
    </section>

    <!-- SPORTS CATEGORIES SECTION -->
    <section id="categories" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
            <div>
                <span class="text-xs font-bold text-sage-600 uppercase tracking-widest">Curated Disciplines</span>
                <h2 class="text-3xl sm:text-4xl font-bold text-charcoal mt-1 tracking-tight">Explore by Sport</h2>
            </div>
            <p class="text-muted text-sm max-w-md mt-2 md:mt-0 leading-relaxed">Specialized gear collections tailored for high endurance, precision control, and tactical agility.</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6">
            <!-- Cricket -->
            <div onclick="filterByCategory('Cricket')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-baseball-bat-ball text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Cricket</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">14 Products</span>
            </div>

            <!-- Football -->
            <div onclick="filterByCategory('Football')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-futbol text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Football</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">18 Products</span>
            </div>

            <!-- Volleyball -->
            <div onclick="filterByCategory('Volleyball')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-volleyball text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Volleyball</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">10 Products</span>
            </div>

            <!-- Basketball -->
            <div onclick="filterByCategory('Basketball')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-basketball text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Basketball</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">12 Products</span>
            </div>

            <!-- Badminton -->
            <div onclick="filterByCategory('Badminton')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-table-tennis-paddle-ball text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Badminton</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">15 Products</span>
            </div>

            <!-- Fitness -->
            <div onclick="filterByCategory('Fitness')" class="group cursor-pointer bg-white p-6 rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
                <div class="w-14 h-14 mb-4 rounded-2xl bg-sage-50 text-sage-700 flex items-center justify-center group-hover:bg-sage-600 group-hover:text-cream transition-all duration-300 shadow-sm">
                    <i class="fa-solid fa-dumbbell text-xl"></i>
                </div>
                <h3 class="font-bold text-charcoal group-hover:text-sage-600 transition-colors text-sm sm:text-base">Fitness</h3>
                <span class="text-[11px] text-muted mt-1 font-medium">22 Products</span>
            </div>
        </div>
    </section>

    <!-- PRODUCT CATALOG SECTION -->
    <section id="shop" class="py-20 bg-white border-y border-sand">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Title & Filter Bar -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-10">
                <div>
                    <span class="text-xs font-bold text-sage-600 uppercase tracking-widest">Selected Inventory</span>
                    <h2 class="text-3xl font-bold text-charcoal mt-1 tracking-tight">Product Catalog</h2>
                </div>

                <!-- Filter Controls -->
                <div class="flex flex-wrap items-center gap-3">
                    <!-- Category Pill Filters -->
                    <div class="flex flex-wrap items-center gap-1.5 bg-cream p-1.5 rounded-full border border-sand" id="categoryPillContainer">
                        <button onclick="filterByCategory('All')" class="category-pill active px-4 py-1.5 rounded-full text-xs font-semibold bg-sage-600 text-white shadow-sm transition-all">All</button>
                        <button onclick="filterByCategory('Cricket')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Cricket</button>
                        <button onclick="filterByCategory('Football')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Football</button>
                        <button onclick="filterByCategory('Volleyball')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Volleyball</button>
                        <button onclick="filterByCategory('Basketball')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Basketball</button>
                        <button onclick="filterByCategory('Badminton')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Badminton</button>
                        <button onclick="filterByCategory('Fitness')" class="category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all">Fitness</button>
                    </div>

                    <!-- Price Sort Dropdown -->
                    <select id="sortSelect" onchange="sortProducts()" class="px-4 py-2 bg-cream text-charcoal text-xs font-medium border border-sand rounded-full focus:outline-none focus:border-sage-500 cursor-pointer shadow-sm">
                        <option value="featured">Featured Order</option>
                        <option value="lowToHigh">Price: Low to High</option>
                        <option value="highToLow">Price: High to Low</option>
                        <option value="rating">Highest Rated</option>
                    </select>
                </div>
            </div>

            <!-- Product Grid -->
            <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
