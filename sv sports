            dots[currentSlide].classList.add('w-2.5', 'bg-muted/40');

            currentSlide = index;

            slides[currentSlide].classList.remove('opacity-0');
            slides[currentSlide].classList.add('opacity-100');
            dots[currentSlide].classList.remove('w-2.5', 'bg-muted/40');
            dots[currentSlide].classList.add('w-8', 'bg-sage-600');

            clearInterval(slideInterval);
            startCarousel();
        }

        // EVENT LISTENERS SETUP
        function setupEventListeners() {
            // Header Search Input
            document.getElementById('headerSearchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                renderProducts();
            });

            // Mobile Search Input
            document.getElementById('mobileSearchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                renderProducts();
            });

            // Mobile Menu Toggle
            document.getElementById('mobileMenuBtn').addEventListener('click', () => {
                const menu = document.getElementById('mobileMenu');
                const icon = document.getElementById('menuIcon');
                menu.classList.toggle('hidden');
                if (menu.classList.contains('hidden')) {
                    icon.className = 'fa-solid fa-bars text-xl';
                } else {
                    icon.className = 'fa-solid fa-xmark text-xl';
                }
            });

            // Cart Drawer Controls
            document.getElementById('cartBtn').addEventListener('click', openCart);
            document.getElementById('closeCartBtn').addEventListener('click', closeCart);
            document.getElementById('cartDrawerBackdrop').addEventListener('click', closeCart);
        }

        // FILTER & SORT PRODUCTS
        function filterByCategory(category) {
            currentCategory = category;
            
            // Update active pill button UI
            const pills = document.querySelectorAll('.category-pill');
            pills.forEach(pill => {
                if (pill.innerText.trim() === category || (category === 'All' && pill.innerText.trim() === 'All')) {
                    pill.className = 'category-pill active px-4 py-1.5 rounded-full text-xs font-semibold bg-sage-600 text-white shadow-sm transition-all';
                } else {
                    pill.className = 'category-pill px-4 py-1.5 rounded-full text-xs font-medium text-charcoal hover:text-sage-600 transition-all';
                }
            });

            renderProducts();
        }

        function sortProducts() {
            currentSort = document.getElementById('sortSelect').value;
            renderProducts();
        }

        function getFilteredProducts() {
            return products.filter(product => {
                const matchesCategory = (currentCategory === 'All') || (product.category === currentCategory);
                const matchesSearch = product.name.toLowerCase().includes(searchQuery) || 
                                      product.description.toLowerCase().includes(searchQuery) ||
                                      product.category.toLowerCase().includes(searchQuery);
                return matchesCategory && matchesSearch;
            }).sort((a, b) => {
                if (currentSort === 'lowToHigh') return a.price - b.price;
                if (currentSort === 'highToLow') return b.price - a.price;
                if (currentSort === 'rating') return b.rating - a.rating;
                return 0; // Default featured order
            });
        }

        // RENDER PRODUCT CATALOG
        function renderProducts() {
            const list = getFilteredProducts();

            if (list.length === 0) {
                productGrid.innerHTML = '';
                emptyCatalogState.classList.remove('hidden');
                return;
            }

            emptyCatalogState.classList.add('hidden');
            productGrid.innerHTML = list.map(item => `
                <div class="group bg-white rounded-2xl border border-sand hover:border-sage-400 hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
                    <div>
                        <!-- Product Image Box -->
                        <div class="relative bg-sand/20 aspect-square overflow-hidden">
                            <img src="${item.image}" alt="${item.name}" 
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-charcoal text-[10px] font-bold px-2.5 py-1 rounded-full border border-sand shadow-sm">
                                ${item.category}
                            </span>
                            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-charcoal text-[10px] font-bold px-2 py-1 rounded-full flex items-center space-x-1 border border-sand shadow-sm">
                                <i class="fa-solid fa-star text-amber-500 text-[9px]"></i>
                                <span>${item.rating}</span>
                            </div>
                        </div>

                        <!-- Product Content -->
                        <div class="p-5">
                            <h3 class="font-bold text-charcoal text-base group-hover:text-sage-600 transition-colors leading-snug">${item.name}</h3>
                            <p class="text-xs text-muted mt-1.5 line-clamp-2 leading-relaxed">${item.description}</p>
                        </div>
                    </div>

                    <!-- Card Footer / Price & Add Button -->
                    <div class="px-5 pb-5 pt-3 flex items-center justify-between border-t border-sand/40">
                        <div>
                            <span class="text-[10px] text-muted block uppercase font-bold tracking-wider">Price</span>
                            <span class="text-lg font-bold text-charcoal">$${item.price.toFixed(2)}</span>
                        </div>
                        <button onclick="addToCart('${item.id}')" 
                            class="px-4 py-2 bg-sage-600 hover:bg-charcoal text-cream text-xs font-semibold rounded-full transition-all duration-200 flex items-center space-x-1.5 shadow-sm">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // CART LOGIC
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            showToast(`Added ${product.name} to cart`);
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        function updateQuantity(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (!item) return;

            item.quantity += delta;
            if (item.quantity <= 0) {
                removeFromCart(productId);
            } else {
                updateCartUI();
            }
        }

        function updateCartUI() {
            // Total items counter
            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            
            if (totalCount > 0) {
                cartBadge.innerText = totalCount;
                cartBadge.classList.remove('hidden');
                checkoutBtn.removeAttribute('disabled');
            } else {
                cartBadge.classList.add('hidden');
                checkoutBtn.setAttribute('disabled', 'true');
            }

            drawerCartCount.innerText = `${totalCount} item${totalCount === 1 ? '' : 's'}`;

            // Render Cart Item Rows
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-16 text-muted">
                        <i class="fa-solid fa-bag-shopping text-3xl mb-3 text-sand"></i>
                        <p class="text-xs">Your shopping bag is currently empty.</p>
                    </div>
                `;
            } else {
                cartItemsContainer.innerHTML = cart.map(item => `
                    <div class="flex items-center space-x-3 bg-white p-3 rounded-2xl border border-sand shadow-sm">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 rounded-xl object-cover bg-sand/30 flex-shrink-0 border border-sand/50">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-charcoal truncate">${item.name}</h4>
                            <span class="text-xs text-sage-600 font-semibold">$${item.price.toFixed(2)}</span>
                            <div class="flex items-center space-x-2.5 mt-2">
                                <button onclick="updateQuantity('${item.id}', -1)" class="w-5 h-5 rounded-full bg-sand/60 text-charcoal hover:bg-sand flex items-center justify-center text-xs font-bold">-</button>
                                <span class="text-xs font-semibold text-charcoal">${item.quantity}</span>
                                <button onclick="updateQuantity('${item.id}', 1)" class="w-5 h-5 rounded-full bg-sand/60 text-charcoal hover:bg-sand flex items-center justify-center text-xs font-bold">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart('${item.id}')" class="text-muted hover:text-red-500 p-1.5 transition-colors" aria-label="Remove item">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </div>
                `).join('');
            }

            // Billing Calculations
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const shipping = subtotal > 100 || subtotal === 0 ? 0.00 : 15.00;
            const tax = subtotal * 0.08;
            const total = subtotal + shipping + tax;

            cartSubtotal.innerText = `$${subtotal.toFixed(2)}`;
            cartShipping.innerText = shipping === 0 ? (subtotal === 0 ? '$0.00' : 'FREE') : `$${shipping.toFixed(2)}`;
            cartTax.innerText = `$${tax.toFixed(2)}`;
            cartTotal.innerText = `$${total.toFixed(2)}`;

            // Sync with checkout modal labels
            document.getElementById('checkoutSubtotal').innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById('checkoutShipping').innerText = shipping === 0 ? 'FREE' : `$${shipping.toFixed(2)}`;
            document.getElementById('checkoutTax').innerText = `$${tax.toFixed(2)}`;
            document.getElementById('checkoutTotal').innerText = `$${total.toFixed(2)}`;
        }

        function openCart() {
            document.getElementById('cartDrawerBackdrop').classList.remove('opacity-0', 'pointer-events-none');
            document.getElementById('cartDrawer').classList.remove('translate-x-full');
        }

        function closeCart() {
            document.getElementById('cartDrawerBackdrop').classList.add('opacity-0', 'pointer-events-none');
            document.getElementById('cartDrawer').classList.add('translate-x-full');
        }

        // CHECKOUT & ORDER MODAL LOGIC
        function openCheckoutModal() {
            if (cart.length === 0) return;
            closeCart();
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        function handlePlaceOrder(event) {
            event.preventDefault();
            closeCheckoutModal();
            
            // Generate random order reference
            const randomRef = '#SV-' + Math.floor(10000 + Math.random() * 90000);
            document.getElementById('orderRefCode').innerText = randomRef;

            // Clear Cart
            cart = [];
            updateCartUI();

            // Show confirmation
            document.getElementById('successModal').classList.remove('hidden');
        }

        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
        }

        // AI ASSISTANT LOGIC (SV SMART ADVISOR)
        function setAiPrompt(text) {
            document.getElementById('aiInput').value = text;
            handleAiQuery(new Event('submit'));
        }

        function handleAiQuery(e) {
            if (e) e.preventDefault();
            const input = document.getElementById('aiInput');
            const query = input.value.trim();
            if (!query) return;

            const chatFeed = document.getElementById('aiChatFeed');

            // Render User Message
            chatFeed.innerHTML += `
                <div class="flex items-start space-x-3 justify-end">
                    <div class="bg-sage-600 text-cream text-xs sm:text-sm p-3.5 rounded-2xl rounded-tr-none max-w-md shadow-sm">
                        ${escapeHtml(query)}
                    </div>
                </div>
            `;
            input.value = '';
            chatFeed.scrollTop = chatFeed.scrollHeight;

            // Process Recommendation Logic
            setTimeout(() => {
                const results = processAiRecommendation(query);
                
                let responseHtml = `<p class="mb-2">Based on your query, here are my top recommendations:</p>`;
                if (results.length > 0) {
                    responseHtml += `<div class="space-y-2 mt-2">`;
                    results.forEach(item => {
                        responseHtml += `
                            <div class="flex items-center justify-between bg-sage-800/90 p-2.5 rounded-xl border border-sage-700/60 shadow-sm">
                                <div class="flex items-center space-x-2.5 min-w-0">
                                    <img src="${item.image}" class="w-10 h-10 rounded-lg object-cover flex-shrink-0 border border-sage-700">
                                    <div class="truncate">
                                        <div class="font-bold text-cream text-xs truncate">${item.name}</div>
                                        <div class="text-[10px] text-sage-300 font-medium">$${item.price.toFixed(2)} • ${item.category}</div>
                                    </div>
                                </div>
                                <button onclick="addToCart('${item.id}')" class="px-3 py-1.5 bg-sage-500 hover:bg-sage-600 text-cream text-[10px] font-semibold rounded-lg flex-shrink-0 transition-colors shadow-sm">
                                    Add to Cart
                                </button>
                            </div>
                        `;
                    });
                    responseHtml += `</div>`;
                } else {
                    responseHtml = `I couldn't find an exact match for your specific query. Try asking for categories like "Cricket", "Football", "Fitness", or price limits like "under $50".`;
                }

                chatFeed.innerHTML += `
                    <div class="flex items-start space-x-3">
                        <div class="w-8 h-8 rounded-full bg-sage-600 flex items-center justify-center flex-shrink-0 text-cream text-xs font-bold shadow-sm">SV</div>
                        <div class="bg-sage-800/80 text-cream text-xs sm:text-sm p-4 rounded-2xl rounded-tl-none max-w-md border border-sage-700/40">
                            ${responseHtml}
                        </div>
                    </div>
                `;
                chatFeed.scrollTop = chatFeed.scrollHeight;
            }, 450);
        }

        function processAiRecommendation(userQuery) {
            const q = userQuery.toLowerCase();
            
            // Extract potential budget
            let maxBudget = null;
            const budgetMatch = q.match(/under\s* \$?(\d+)/) || q.match(/\$?(\d+)\s*budget/);
            if (budgetMatch) {
                maxBudget = parseFloat(budgetMatch[1]);
            }

            return products.filter(item => {
                let categoryMatch = false;
                if (q.includes('cricket') && item.category === 'Cricket') categoryMatch = true;
                else if (q.includes('football') && item.category === 'Football') categoryMatch = true;
                else if (q.includes('volleyball') && item.category === 'Volleyball') categoryMatch = true;
                else if (q.includes('basketball') && item.category === 'Basketball') categoryMatch = true;
                else if (q.includes('badminton') && item.category === 'Badminton') categoryMatch = true;
                else if ((q.includes('fitness') || q.includes('gym') || q.includes('workout')) && item.category === 'Fitness') categoryMatch = true;
                else if (!q.includes('cricket') && !q.includes('football') && !q.includes('volleyball') && !q.includes('basketball') && !q.includes('badminton') && !q.includes('fitness')) {
                    categoryMatch = true;
                }

                let budgetOk = true;
                if (maxBudget !== null) {
                    budgetOk = item.price <= maxBudget;
                }

                return categoryMatch && budgetOk;
            }).slice(0, 3);
        }

        // UTILITY FUNCTIONS
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function handleNewsletter(e) {
            e.preventDefault();
            showToast('Thank you for subscribing to SV SPORTS newsletter!');
            e.target.reset();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
